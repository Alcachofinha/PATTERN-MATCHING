
### `.gitignore`

```gitignore
# Build directory
build/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Executables
*.exe
*.out
*.app

# Object files
*.o
*.obj

# Libraries
*.a
*.lib
*.dll
*.so
*.dylib

# Debug files
*.pdb
*.ilk

# IDE / Editor files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio
.vs/

# Temporary files
*.tmp
*.temp
*.log

# Operating system files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc

# Backup files
*~
*.bak